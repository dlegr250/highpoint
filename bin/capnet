#!/usr/bin/env ruby

require_relative "../config/environment"
require "optparse"

USAGE = <<~TXT
Usage:
  bin/capnet load <csv_path>
  bin/capnet fetch [--all]
  bin/capnet transform
  bin/capnet package
  bin/capnet push_s3 <raw|transformed|packaged>
TXT

abort(USAGE) if ARGV.empty?
cmd = ARGV.shift

case cmd
when "load"
  path = ARGV.shift
  path || abort(USAGE)
  Capnet.load_file!(path: path, system: :capnet)
when "fetch"
  only_missing = !ARGV.delete("--all")
  Capnet.fetch!(only_missing: only_missing)
when "transform"
  Capnet.transform!
when "package"
  Capnet.package!
when "push_s3"
  stage = ARGV.shift
  stage || abort(USAGE)
  
  bucket = ARGV.shift
  bucket || abort(USAGE)
  Capnet.push_s3!(stage: stage)
else
  abort(USAGE)
end
