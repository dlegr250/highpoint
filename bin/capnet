#!/usr/bin/env ruby

require_relative "../config/environment"
require "optparse"

USAGE = <<~TXT
Usage:
  bin/capnet load <csv_path>
  bin/capnet fetch [--all]
  bin/capnet transform
  bin/capnet package
  bin/capnet push_s3 <raw|transformed|packaged> <bucket> [prefix]
TXT

abort USAGE if ARGV.empty?
cmd = ARGV.shift

case cmd
when "load"
  path = ARGV.shift or abort USAGE
  Capnet.load_csv!(path)
when "fetch"
  only_missing = !ARGV.delete("--all")
  Capnet.fetch!(only_missing: only_missing)
when "transform"
  Capnet.transform!
when "package"
  Capnet.package!
when "push_s3"
  stage = ARGV.shift or abort USAGE
  bucket = ARGV.shift or abort USAGE
  prefix = ARGV.shift
  Capnet.push_s3!(stage: stage, bucket: bucket, prefix: (prefix || "highpoint/capnet"))
else
  abort USAGE
end
